NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Public HTTPS origin of the customer trace page used inside lot QR codes.
# When set, the QR encodes <base>/truy-xuat/<traceCode> so a stock phone
# camera opens the page directly. Leave empty in local dev: the QR then
# encodes the bare trace code (localhost/LAN IPs are never printed on labels).
# Example: NEXT_PUBLIC_TRACE_BASE_URL=https://shop.agrimarket.vn
NEXT_PUBLIC_TRACE_BASE_URL=
