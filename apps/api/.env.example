# AgriMarket V2 API — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

# Main development database
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/agrimarket_v2"

# Dedicated database for e2e tests (destructive tests run only here)
TEST_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/agrimarket_v2_test"

# JWT
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"

# HTTP
PORT=3000
# Browser origins allowed to call the API (exact match, never "*").
# Admin Web = 3001, Customer Web = 3002, Expo Web = 8081 (8082 if 8081 is taken).
# Add "http://<YOUR_PC_LAN_IP>:8081" if you open Expo Web from another device.
# When this variable is empty the API falls back to the localhost dev clients
# only (3001/3002/8081/8082), so an unset value fails closed.
CORS_ORIGIN="http://localhost:3001,http://localhost:3002,http://localhost:8081,http://localhost:8082"

# Product image uploads: directory for stored files (relative to apps/api or
# absolute). Served back at /uploads/... with stable absolute URLs.
UPLOADS_DIR="uploads"

# Base URL used to build absolute image URLs. Empty = derived from the request.
PUBLIC_API_BASE_URL="http://localhost:3000"

# Customer Web base URL. Password-recovery links point here.
CUSTOMER_WEB_URL="http://localhost:3002"

# --- Mail (password recovery) ------------------------------------------------
# MAIL_TRANSPORT selects the transport:
#   "smtp" -> real delivery over the network (requires SMTP_HOST below)
#   "test" -> messages are captured in memory, nothing is sent
# Leave unset to auto-select: smtp when SMTP_HOST is set, otherwise test.
# The API reports the active mode, so a "test" transport is never presented to
# the customer as a delivered e-mail.
MAIL_TRANSPORT="test"
MAIL_FROM="AgriMarket <no-reply@agrimarket.vn>"

# SMTP server. Only used when MAIL_TRANSPORT=smtp. Never commit real values.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
