  @@index([partnerId])
  @@map("settlements")
}

model SettlementLine {
  id               Int      @id @default(autoincrement())
  settlementId     Int      @map("settlement_id")
  partnerOrderId   Int      @map("partner_order_id")
  grossAmount      Decimal  @map("gross_amount") @db.Decimal(18, 2)
  refundAmount     Decimal  @default(0) @map("refund_amount") @db.Decimal(18, 2)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(18, 2)
  payableAmount    Decimal  @map("payable_amount") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  settlement   Settlement   @relation(fields: [settlementId], references: [id])
  partnerOrder PartnerOrder @relation(fields: [partnerOrderId], references: [id])

  @@index([settlementId])
  @@map("settlement_lines")
}

model Payout {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  settlementId Int          @map("settlement_id")
  partnerId    Int          @map("partner_id")
  amount       Decimal      @db.Decimal(18, 2)
  status       PayoutStatus @default(PENDING)
  reference    String?
  requestedAt  DateTime     @map("requested_at")
  paidAt       DateTime?    @map("paid_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  settlement Settlement @relation(fields: [settlementId], references: [id])
  partner    Partner    @relation(fields: [partnerId], references: [id])

  @@index([settlementId])
  @@index([partnerId])
  @@map("payouts")
}

