/// One evidence photo attached to a review, complaint or return request.
///
/// WHY ONE TABLE WITH THREE NULLABLE FKs
///
/// The three workflows need the same thing — up to five validated images with
/// the same size/format rules, the same private-serving policy and the same
/// thumbnails — and they differ only in what owns them. Three near-identical
/// tables would triple the validation and the access checks, which is where
/// security bugs hide. A single table with a database-level CHECK that exactly
/// one owner is set keeps every image reachable by exactly one policy.
///
/// PRIVACY
///
/// The file is never served from a public path. `storageKey` is an opaque UUID
/// file name inside a private directory, and every read goes through
/// `GET /evidence/:id/file`, which resolves the owner and checks the caller.
/// Review images become readable by anyone only once the review is APPROVED.
///
/// Additive: a new table, no change to `reviews`, `complaints` or
/// `return_requests`, so every existing row and query keeps working.
model EvidenceImage {
  id           Int      @id @default(autoincrement())
  /// Opaque file name on disk (UUID + extension). Never a user-supplied name.
  storageKey   String   @map("storage_key") @db.VarChar(128)
  mimeType     String   @map("mime_type") @db.VarChar(64)
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  /// Original name as reported by the client, kept for support only. Never used
  /// to build a path.
  originalName String?  @map("original_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  /// Set when the upload is confirmed against an entity. NULL means the file
  /// was uploaded but never bound; such rows are swept after a short TTL.
  uploadedById Int      @map("uploaded_by_id")

  reviewId      Int? @map("review_id")
  complaintId   Int? @map("complaint_id")
  returnId      Int? @map("return_id")
  sortOrder     Int  @default(0) @map("sort_order")

  uploadedBy User           @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  review     Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  complaint  Complaint?     @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  returnReq  ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([complaintId])
  @@index([returnId])
  @@index([uploadedById, createdAt])
  @@map("evidence_images")
}

