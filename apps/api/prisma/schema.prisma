// AgriMarket V2 — Prisma schema (clean slate)
// Database: MySQL 8.4, utf8mb4. Business identifiers are human-readable codes
// (PARTNER-0001, ORD-20261007-0001, ...); internal ids are autoincrement ints.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum SeasonStatus {
  PLANNED
  GROWING
  HARVESTING
  COMPLETED
  CANCELLED
}

enum FarmingEventType {
  WATERING
  FERTILIZING
  PEST_CHECK
  CARE
  OTHER
}

enum CertificateVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductLotStatus {
  PENDING_QC
  QUARANTINED
  SELLABLE
  REJECTED
  RECALLED
  EXPIRED
  LOCKED
}

enum QcResult {
  PASS
  FAIL
}

enum TraceEventType {
  HARVEST
  QC
  PACKING
  WAREHOUSE_IN
  WAREHOUSE_OUT
  SHIPPING
  DELIVERED
  RETURNED
}

enum WarehouseDocumentType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  RETURN
}

enum WarehouseDocumentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  RESERVE
  RELEASE
  RETURN
  QUARANTINE
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PartnerOrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PACKING
  PACKED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED
}

enum PaymentMethod {
  COD
  VNPAY
  MOCK_ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ComplaintType {
  PRODUCT_QUALITY
  DELIVERY
  WRONG_ITEM
  OTHER
}

enum ComplaintStatus {
  OPEN
  PROCESSING
  RESOLVED
  REJECTED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  RETURNING
  RECEIVED
  QC_PENDING
  REFUNDED
  REJECTED
}

enum SettlementStatus {
  DRAFT
  CONFIRMED
  PAID
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

// ---------------------------------------------------------------------------
// A. Users
// ---------------------------------------------------------------------------

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  phone        String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  /// When the password last changed.
  ///
  /// Access tokens are stateless JWTs, so a password change cannot delete them
  /// from a session store. Instead `JwtStrategy` rejects any token issued
  /// before this instant, which is what actually invalidates sessions that were
  /// open when the password changed (including an attacker's).
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  customerProfile    CustomerProfile?
  cart               Cart?
  orders             Order[]
  reviews            Review[]
  complaints         Complaint[]
  returnRequests     ReturnRequest[]
  voucherRedemptions VoucherRedemption[]
  checkoutKeys       CheckoutIdempotencyKey[]
  passwordResetTokens PasswordResetToken[]
  qcInspections      QcInspection[]      @relation("QcInspector")
  warehouseDocuments WarehouseDocument[] @relation("WarehouseDocCreator")
  inventoryMovements InventoryMovement[] @relation("MovementCreator")
  auditLogs          AuditLog[]
  evidenceUploads    EvidenceImage[]     @relation("EvidenceUploader")

  @@map("users")
}

/// Single-use password-reset token.
///
/// Only the SHA-256 HASH of the token is stored: the raw token exists exactly
/// once, inside the recovery e-mail, so a database leak cannot be replayed into
/// an account takeover. `usedAt` marks consumption — a token is valid only while
/// `usedAt` is null and `expiresAt` is in the future, so a token is single-use
/// even if the e-mail is opened twice.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// SHA-256 hex of the raw token. The raw value is never persisted.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CustomerProfile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique @map("user_id")
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  dateOfBirth   DateTime? @map("date_of_birth")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  addresses Address[]

  @@map("customer_profiles")
}

/// A customer's saved shipping address.
///
/// Two address generations coexist here on purpose:
///
///   - `district` / `ward` / `province` are the ORIGINAL free-text columns.
///     They still hold whatever the customer typed before the 2025
///     administrative reorganisation, and rows are never rewritten by guesswork
///     — a historical address keeps the text it was saved with.
///   - `provinceCode` / `wardCode` / `wardName` are the ADDITIVE, verified
///     columns for the new two-level model (tỉnh → xã/phường, no huyện). When
///     `wardCode` is set, `wardName` is the official name resolved from the
///     `Ward` catalogue on the server — never the client's own text.
///
/// `district` is deliberately NOT dropped: dropping it would destroy the
/// historical text of addresses saved before the reorganisation. It is simply
/// no longer collected for new addresses.
model Address {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  recipientName String   @map("recipient_name")
  phone         String
  province      String
  district      String?
  ward          String?
  village       String?
  detail        String
  isDefault     Boolean  @default(false) @map("is_default")
  /// Official province code, e.g. "33" for Hưng Yên. Null on legacy rows.
  provinceCode  String?  @map("province_code") @db.VarChar(20)
  /// Official 5-digit commune code from the verified `Ward` catalogue.
  wardCode      String?  @map("ward_code") @db.VarChar(5)
  /// Display name resolved server-side from `wardCode` (e.g. "Phường Phố Hiến").
  wardName      String?  @map("ward_name") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([wardCode])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// A2. Administrative catalogue (tỉnh → xã/phường, two-level model)
// ---------------------------------------------------------------------------

/// Province of the two-level administrative model. Only Hưng Yên (`33`) is
/// seeded, because the storefront ships inside Hưng Yên only — a decorative
/// nationwide list would be a lie about where AgriMarket delivers.
model Province {
  code      String   @id @db.VarChar(20)
  name      String   @db.VarChar(120)
  fullName  String   @map("full_name") @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wards Ward[]

  @@map("provinces")
}

/// One commune-level unit (xã / phường) of the post-reorganisation catalogue.
///
/// This table is the SINGLE source of truth for the 104 Hưng Yên units: Admin,
/// Customer Web and Mobile all read it through `GET /locations/...` and none of
/// them embeds its own copy of the list.
///
/// `code` is a `VarChar(5)` string, never an integer: administrative codes have
/// significant leading zeros, and storing them numerically would corrupt them.
/// `searchText` is a pre-computed, accent-stripped haystack (e.g. "phuong pho
/// hien") so an unaccented query like "pho hien" matches without a per-request
/// accent-folding pass.
model Ward {
  code         String   @id @db.VarChar(5)
  provinceCode String   @map("province_code") @db.VarChar(20)
  /// "xa" | "phuong" — the unit class, as published.
  type         String   @db.VarChar(10)
  /// Official name WITHOUT the "Xã"/"Phường" prefix (e.g. "Phố Hiến").
  name         String   @db.VarChar(120)
  /// Official name WITH the prefix (e.g. "Phường Phố Hiến") — what is displayed.
  fullName     String   @map("full_name") @db.VarChar(160)
  /// Accent-stripped, lower-cased search haystack.
  searchText   String   @map("search_text") @db.VarChar(200)
  /// Date this unit became effective (ISO date string, e.g. "2025-07-01").
  effectiveFrom String? @map("effective_from") @db.VarChar(10)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  province Province @relation(fields: [provinceCode], references: [code])

  @@index([provinceCode])
  @@index([status])
  @@map("wards")
}

// ---------------------------------------------------------------------------
// B. Partner & Farm
// ---------------------------------------------------------------------------

model Partner {
  id                 Int          @id @default(autoincrement())
  code               String       @unique
  name               String
  representativeName String       @map("representative_name")
  phone              String
  email              String
  address            String
  taxCode            String?      @map("tax_code")
  bankAccountName    String?      @map("bank_account_name")
  bankAccountNumber  String?      @map("bank_account_number")
  bankName           String?      @map("bank_name")
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  farms           Farm[]
  products        Product[]
  partnerOrders   PartnerOrder[]
  commissionRules CommissionRule[]
  settlements     Settlement[]
  payouts         Payout[]

  @@index([name])
  @@index([phone])
  @@map("partners")
}

model Farm {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  partnerId   Int          @map("partner_id")
  name        String
  address     String
  latitude    Decimal?     @db.Decimal(10, 7)
  longitude   Decimal?     @db.Decimal(10, 7)
  areaHa      Decimal?     @map("area_ha") @db.Decimal(10, 2)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  partner      Partner       @relation(fields: [partnerId], references: [id])
  seasons      Season[]
  certificates Certificate[]
  products     Product[]

  @@index([partnerId])
  @@index([name])
  @@map("farms")
}

// ---------------------------------------------------------------------------
// C. Season / Farming log / Harvest
// ---------------------------------------------------------------------------

model Season {
  id                  Int          @id @default(autoincrement())
  farmId              Int          @map("farm_id")
  cropName            String       @map("crop_name")
  variety             String?
  plantingDate        DateTime?    @map("planting_date")
  expectedHarvestDate DateTime?    @map("expected_harvest_date")
  expectedYield       Decimal?     @map("expected_yield") @db.Decimal(18, 3)
  yieldUnit           String?      @map("yield_unit")
  status              SeasonStatus @default(PLANNED)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  farm          Farm           @relation(fields: [farmId], references: [id])
  farmingEvents FarmingEvent[]
  harvests      Harvest[]

  @@index([farmId])
  @@map("seasons")
}

model FarmingEvent {
  id         Int              @id @default(autoincrement())
  seasonId   Int              @map("season_id")
  type       FarmingEventType
  occurredAt DateTime         @map("occurred_at")
  content    String           @db.Text
  isPublic   Boolean          @default(true) @map("is_public")
  createdAt  DateTime         @default(now()) @map("created_at")

  season Season @relation(fields: [seasonId], references: [id])

  @@index([seasonId])
  @@map("farming_events")
}

model Harvest {
  id          Int      @id @default(autoincrement())
  seasonId    Int      @map("season_id")
  harvestDate DateTime @map("harvest_date")
  quantity    Decimal  @db.Decimal(18, 3)
  unit        String
  grade       String
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  season      Season       @relation(fields: [seasonId], references: [id])
  productLots ProductLot[]

  @@index([seasonId])
  @@map("harvests")
}

// ---------------------------------------------------------------------------
// D. Certificate
// ---------------------------------------------------------------------------

model Certificate {
  id                 Int                           @id @default(autoincrement())
  farmId             Int                           @map("farm_id")
  type               String
  certificateCode    String                        @map("certificate_code")
  issuer             String
  issuedAt           DateTime                      @map("issued_at")
  expiresAt          DateTime                      @map("expires_at")
  fileUrl            String?                       @map("file_url")
  verificationStatus CertificateVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                     @map("verified_at")
  rejectionReason    String?                       @map("rejection_reason") @db.Text
  status             RecordStatus                  @default(ACTIVE)
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// E. Catalog
// ---------------------------------------------------------------------------

model Category {
  id        Int          @id @default(autoincrement())
  name      String
  slug      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products        Product[]
  commissionRules CommissionRule[]

  @@map("categories")
}

model Product {
  id          Int          @id @default(autoincrement())
  partnerId   Int          @map("partner_id")
  categoryId  Int          @map("category_id")
  farmId      Int?         @map("farm_id")
  name        String
  slug        String       @unique
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  partner     Partner          @relation(fields: [partnerId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  farm        Farm?            @relation(fields: [farmId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  productLots ProductLot[]
  reviews     Review[]

  @@index([partnerId])
  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  mimeType  String?  @map("mime_type") @db.VarChar(64)
  width     Int?
  height    Int?
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         Int          @id @default(autoincrement())
  productId  Int          @map("product_id")
  sku        String       @unique
  name       String
  weight     Decimal?     @db.Decimal(10, 3)
  weightUnit String?      @map("weight_unit")
  saleUnit   String       @map("sale_unit")
  basePrice  Decimal      @map("base_price") @db.Decimal(18, 2)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  product                Product                 @relation(fields: [productId], references: [id])
  cartItems              CartItem[]
  orderItems             OrderItem[]
  inventoryBalances      InventoryBalance[]
  warehouseDocumentLines WarehouseDocumentLine[]
  inventoryMovements     InventoryMovement[]
  productDiscounts       ProductDiscount[]
  flashSaleItems         FlashSaleItem[]

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// F. Product lot
// ---------------------------------------------------------------------------

model ProductLot {
  id                Int              @id @default(autoincrement())
  code              String           @unique
  productId         Int              @map("product_id")
  harvestId         Int              @map("harvest_id")
  quantity          Decimal          @db.Decimal(18, 3)
  unit              String
  remainingQuantity Decimal          @map("remaining_quantity") @db.Decimal(18, 3)
  grade             String
  packedAt          DateTime?        @map("packed_at")
  expiresAt         DateTime         @map("expires_at")
  status            ProductLotStatus @default(PENDING_QC)
  traceCode         String           @unique @map("trace_code")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  product                Product                 @relation(fields: [productId], references: [id])
  harvest                Harvest                 @relation(fields: [harvestId], references: [id])
  qcInspections          QcInspection[]
  traceEvents            TraceEvent[]
  inventoryBalances      InventoryBalance[]
  warehouseDocumentLines WarehouseDocumentLine[]
  inventoryMovements     InventoryMovement[]
  inventoryAllocations   InventoryAllocation[]

  @@index([productId])
  @@index([harvestId])
  @@index([status])
  @@map("product_lots")
}

// ---------------------------------------------------------------------------
// G. Quality control
// ---------------------------------------------------------------------------

model QcInspection {
  id               Int      @id @default(autoincrement())
  productLotId     Int      @map("product_lot_id")
  inspectorUserId  Int      @map("inspector_user_id")
  result           QcResult
  appearancePassed Boolean  @map("appearance_passed")
  freshnessPassed  Boolean  @map("freshness_passed")
  packagingPassed  Boolean? @map("packaging_passed")
  damagePassed     Boolean  @map("damage_passed")
  note             String?  @db.Text
  inspectedAt      DateTime @map("inspected_at")
  createdAt        DateTime @default(now()) @map("created_at")

  productLot    ProductLot @relation(fields: [productLotId], references: [id])
  inspectorUser User       @relation("QcInspector", fields: [inspectorUserId], references: [id])

  @@index([productLotId])
  @@map("qc_inspections")
}

// ---------------------------------------------------------------------------
// H. Traceability
// ---------------------------------------------------------------------------

model TraceEvent {
  id           Int            @id @default(autoincrement())
  productLotId Int            @map("product_lot_id")
  type         TraceEventType
  occurredAt   DateTime       @map("occurred_at")
  location     String?
  description  String?        @db.Text
  isPublic     Boolean        @default(true) @map("is_public")
  createdAt    DateTime       @default(now()) @map("created_at")

  productLot ProductLot @relation(fields: [productLotId], references: [id])

  @@index([productLotId])
  @@map("trace_events")
}

// ---------------------------------------------------------------------------
// I. Warehouse & inventory
// ---------------------------------------------------------------------------

model Warehouse {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  name      String
  address   String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  inventoryBalances  InventoryBalance[]
  warehouseDocuments WarehouseDocument[]
  inventoryMovements InventoryMovement[]

  @@map("warehouses")
}

model InventoryBalance {
  id               Int      @id @default(autoincrement())
  warehouseId      Int      @map("warehouse_id")
  productLotId     Int      @map("product_lot_id")
  productVariantId Int      @map("product_variant_id")
  onHand           Decimal  @default(0) @map("on_hand") @db.Decimal(18, 3)
  reserved         Decimal  @default(0) @db.Decimal(18, 3)
  blocked          Decimal  @default(0) @db.Decimal(18, 3)
  unit             String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  productLot     ProductLot            @relation(fields: [productLotId], references: [id])
  productVariant ProductVariant        @relation(fields: [productVariantId], references: [id])
  allocations    InventoryAllocation[]

  @@unique([warehouseId, productLotId, productVariantId])
  @@index([productVariantId])
  @@map("inventory_balances")
}

model WarehouseDocument {
  id              Int                     @id @default(autoincrement())
  code            String                  @unique
  warehouseId     Int                     @map("warehouse_id")
  type            WarehouseDocumentType
  sourceType      String?                 @map("source_type")
  sourceId        Int?                    @map("source_id")
  status          WarehouseDocumentStatus @default(DRAFT)
  note            String?                 @db.Text
  createdByUserId Int                     @map("created_by_user_id")
  completedAt     DateTime?               @map("completed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  warehouse     Warehouse               @relation(fields: [warehouseId], references: [id])
  createdByUser User                    @relation("WarehouseDocCreator", fields: [createdByUserId], references: [id])
  lines         WarehouseDocumentLine[]

  @@index([warehouseId])
  @@map("warehouse_documents")
}

model WarehouseDocumentLine {
  id               Int     @id @default(autoincrement())
  documentId       Int     @map("document_id")
  productLotId     Int     @map("product_lot_id")
  productVariantId Int     @map("product_variant_id")
  quantity         Decimal @db.Decimal(18, 3)
  unit             String

  document       WarehouseDocument @relation(fields: [documentId], references: [id])
  productLot     ProductLot        @relation(fields: [productLotId], references: [id])
  productVariant ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@index([documentId])
  @@map("warehouse_document_lines")
}

model InventoryMovement {
  id               Int                   @id @default(autoincrement())
  warehouseId      Int                   @map("warehouse_id")
  productLotId     Int                   @map("product_lot_id")
  productVariantId Int                   @map("product_variant_id")
  type             InventoryMovementType
  quantityDelta    Decimal               @map("quantity_delta") @db.Decimal(18, 3)
  beforeQuantity   Decimal               @map("before_quantity") @db.Decimal(18, 3)
  afterQuantity    Decimal               @map("after_quantity") @db.Decimal(18, 3)
  referenceType    String?               @map("reference_type")
  referenceId      Int?                  @map("reference_id")
  note             String?               @db.Text
  createdByUserId  Int?                  @map("created_by_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  productLot     ProductLot     @relation(fields: [productLotId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  createdByUser  User?          @relation("MovementCreator", fields: [createdByUserId], references: [id])

  @@index([warehouseId])
  @@index([productLotId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// J. Cart
// ---------------------------------------------------------------------------

model Cart {
  id         Int      @id @default(autoincrement())
  customerId Int      @unique @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer User       @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id               Int      @id @default(autoincrement())
  cartId           Int      @map("cart_id")
  productVariantId Int      @map("product_variant_id")
  quantity         Decimal  @db.Decimal(18, 3)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cart           Cart           @relation(fields: [cartId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// K. Order
// ---------------------------------------------------------------------------

model Order {
  id                      Int         @id @default(autoincrement())
  code                    String      @unique
  customerId              Int         @map("customer_id")
  shippingAddressSnapshot Json        @map("shipping_address_snapshot")
  subtotal                Decimal     @db.Decimal(18, 2)
  discountTotal           Decimal     @default(0) @map("discount_total") @db.Decimal(18, 2)
  shippingFee             Decimal     @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  grandTotal              Decimal     @map("grand_total") @db.Decimal(18, 2)
  status                  OrderStatus @default(PENDING_CONFIRMATION)
  note                    String?     @db.Text
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  customer           User                      @relation(fields: [customerId], references: [id])
  partnerOrders      PartnerOrder[]
  payments           Payment[]
  voucherRedemptions VoucherRedemption[]
  complaints         Complaint[]
  returnRequests     ReturnRequest[]
  checkoutKeys       CheckoutIdempotencyKey[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

/// Checkout idempotency keys.
///
/// A key is unique per customer and bound to the hash of the checkout payload
/// it was first used with, so:
///   - the same key + the same payload returns the original order (retry, or a
///     retry after the response was lost);
///   - the same key + a different payload is rejected instead of silently
///     creating a second order.
/// The row is written inside the checkout transaction, so a rolled-back
/// checkout never leaves a key behind and the retry can succeed later.
model CheckoutIdempotencyKey {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  key         String
  requestHash String   @map("request_hash")
  orderId     Int?     @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer User   @relation(fields: [customerId], references: [id])
  order    Order? @relation(fields: [orderId], references: [id])

  @@unique([customerId, key])
  @@index([orderId])
  @@map("checkout_idempotency_keys")
}

/// Daily business-code counters, one row per `<PREFIX>-<YYYYMMDD>-`.
///
/// WHY: `nextOrderCode` used to derive the next number from the highest
/// existing `orders.code` of the day. Two concurrent checkouts read the same
/// maximum, built the same `ORD-YYYYMMDD-NNNN`, and all but one collided on
/// the unique index; the retry storm interleaved with the checkout write set
/// and produced deadlocks (P2034 / MySQL 1213) and transaction timeouts
/// (P2028) instead of two orders.
///
/// HOW: allocation is a single
/// `INSERT ... ON DUPLICATE KEY UPDATE value = value + 1` followed by a
/// `SELECT value`. Every writer queues on the same row's exclusive lock and
/// leaves with a distinct number — no gap locks, no duplicate-key retries.
/// The counter lives inside the checkout transaction (sequence lock first,
/// balances second), so the lock order is globally consistent and a rolled
/// back checkout does not burn a number.
model CodeSequence {
  name      String   @id @db.VarChar(64)
  value     BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("code_sequences")
}

model PartnerOrder {
  id               Int                @id @default(autoincrement())
  code             String             @unique
  orderId          Int                @map("order_id")
  partnerId        Int                @map("partner_id")
  subtotal         Decimal            @db.Decimal(18, 2)
  discountTotal    Decimal            @default(0) @map("discount_total") @db.Decimal(18, 2)
  commissionAmount Decimal            @default(0) @map("commission_amount") @db.Decimal(18, 2)
  payableAmount    Decimal            @default(0) @map("payable_amount") @db.Decimal(18, 2)
  status           PartnerOrderStatus @default(PENDING_CONFIRMATION)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  order           Order            @relation(fields: [orderId], references: [id])
  partner         Partner          @relation(fields: [partnerId], references: [id])
  items           OrderItem[]
  fulfillments    Fulfillment[]
  shipments       Shipment[]
  settlementLines SettlementLine[]

  @@index([orderId])
  @@index([partnerId])
  @@map("partner_orders")
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  partnerOrderId      Int      @map("partner_order_id")
  productVariantId    Int      @map("product_variant_id")
  productNameSnapshot String   @map("product_name_snapshot")
  skuSnapshot         String   @map("sku_snapshot")
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(18, 2)
  quantity            Decimal  @db.Decimal(18, 3)
  subtotal            Decimal  @db.Decimal(18, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  /// The exact flash-sale item whose price this line was charged at.
  ///
  /// Snapshot of the *program*, not the price: quota is consumed from and the
  /// per-customer limit is counted against this id, so two sales that happen to
  /// share a price — or a normal purchase that lands on the same price — can
  /// never be confused with one another. `NULL` for a non-flash line.
  flashSaleItemId     Int?     @map("flash_sale_item_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  partnerOrder   PartnerOrder          @relation(fields: [partnerOrderId], references: [id])
  productVariant ProductVariant        @relation(fields: [productVariantId], references: [id])
  flashSaleItem  FlashSaleItem?        @relation(fields: [flashSaleItemId], references: [id], onDelete: SetNull)
  allocations    InventoryAllocation[]
  reviews        Review[]
  returnRequests ReturnRequest[]
  complaints     Complaint[]

  @@index([partnerOrderId])
  @@index([flashSaleItemId])
  @@map("order_items")
}

