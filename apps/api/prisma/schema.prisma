  partnerId        Int              @map("partner_id")
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  grossAmount      Decimal          @map("gross_amount") @db.Decimal(18, 2)
  refundAmount     Decimal          @default(0) @map("refund_amount") @db.Decimal(18, 2)
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(18, 2)
  adjustmentAmount Decimal          @default(0) @map("adjustment_amount") @db.Decimal(18, 2)
  payableAmount    Decimal          @map("payable_amount") @db.Decimal(18, 2)
  status           SettlementStatus @default(DRAFT)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  confirmedAt      DateTime?        @map("confirmed_at")

  partner Partner          @relation(fields: [partnerId], references: [id])
