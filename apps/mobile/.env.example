# Copy to `.env` and set the LAN address of the machine running the API.
# The phone (Expo Go) must reach this URL over the same Wi-Fi network.
# NEVER use localhost here: localhost on the phone is the phone itself.
#
# Single source of truth: only this variable decides the API address.
# Find the current LAN IP on Windows with `ipconfig` (IPv4 on Wi-Fi),
# then restart Expo. Example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:3000/api/v1
