# deps
node_modules/
node_modules_pnpm_broken/
node_modules_npm_tmp/
.pnpm-store/

# builds
dist/
build/
.next/
out/
.generated/
generated/

# env
.env
.env.*
!.env.example

# local database backups (SQL dumps — never commit)
/backups/

# uploaded product images (local files — never commit)
/apps/api/uploads/
/uploads/

# logs
*.log
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# git
*.orig

# local tooling state / scratch dirs (may contain tokens — never commit)
.kilo/
.playwright-mcp/
.tmp-verify/

# Playwright: saved browser sessions contain live JWTs, and the report/trace
# output is build artefact, not source.
e2e/.auth/
test-results/
playwright-report/
blob-report/

# Expo local state (device history, dev-server settings) even if an app-level
# .gitignore is ever removed: `npx expo-doctor` flags it, and it is machine-specific.
.expo/

# npm workspaces: the root package-lock.json is the single source of truth
apps/*/package-lock.json
packages/*/package-lock.json
