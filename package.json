{
  "name": "agrimarket",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev:api": "npm run dev --workspace @agrimarket/api",
    "dev:admin": "npm run dev --workspace @agrimarket/admin-web",
    "dev:customer": "npm run dev --workspace @agrimarket/customer-web",
    "dev:mobile": "npm run dev --workspace @agrimarket/mobile",
    "demo:mobile": "node scripts/lan/demo-mobile.mjs",
    "demo:all": "node scripts/lan/demo-all.mjs",
    "lan:diagnose": "node scripts/lan/diagnose.mjs",
    "lan:test": "node --test scripts/lan/lib.test.mjs",
    "start:api": "npm run start --workspace @agrimarket/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @agrimarket/api",
    "security:smoke": "node scripts/security-smoke.mjs",
    "verify:local": "node scripts/local-verify.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:invariants": "node scripts/db-invariant-audit.mjs",
    "verify:backup": "node scripts/backup-restore-drill.mjs",
    "verify:security": "node scripts/security-scan.mjs",
    "verify:business": "node scripts/business-smoke.mjs",
    "verify:load": "node scripts/load-test.mjs",
    "verify:ui": "node scripts/ui-smoke.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "db:generate": "npm run db:generate --workspace @agrimarket/api",
    "db:migrate": "npm run db:migrate --workspace @agrimarket/api",
    "db:deploy": "npm run db:deploy --workspace @agrimarket/api",
    "db:seed": "npm run db:seed --workspace @agrimarket/api"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "multer": "2.5.0",
    "undici": "8.12.3",
    "fast-uri": "3.1.9"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
